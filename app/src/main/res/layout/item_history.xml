<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Honda.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:id="@+id/tvComponent" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/TextAppearance.Honda.Title" />
        <TextView android:id="@+id/tvDate" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/TextAppearance.Honda.Caption" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvOdometer" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/TextAppearance.Honda.Body" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/tvNotes" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/TextAppearance.Honda.Body" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>