<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white">

    <View
        android:id="@+id/mStripe"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/honda_stripe"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header Panel -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/mStripe">

        <TextView
            android:id="@+id/tvVehicleHeader"
            style="@style/TextAppearance.Honda.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VEHICLE DETAIL"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvOdometerInfo"
            style="@style/TextAppearance.Honda.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Odometer: - km"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Quick Action Buttons -->
    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/llHeader">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInputLog"
            style="@style/Widget.Honda.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Input Servis" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.Honda.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Riwayat" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteVehicle"
        style="@style/Widget.Honda.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:text="Hapus Kendaraan"
        app:layout_constraintTop_toBottomOf="@id/llActions" />

    <!-- Components List Title -->
    <TextView
        android:id="@+id/tvComponentsTitle"
        style="@style/TextAppearance.Honda.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="KESEHATAN KOMPONEN"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnDeleteVehicle" />

    <!-- Recycler Component Health -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvComponentHealth"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvComponentsTitle" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddComponent"
        style="@style/Widget.Honda.FAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>