<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/TextAppearance.Honda.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAMBAH KENDARAAN"
        android:textSize="24sp"
        android:layout_marginBottom="4dp" />

    <TextView
        style="@style/TextAppearance.Honda.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Isi data kendaraan baru Anda"
        android:layout_marginBottom="24dp" />

    <!-- Dropdown Merk & Tipe Motor -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBrandType"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Merk &amp; Tipe Motor">

        <AutoCompleteTextView
            android:id="@+id/actvBrandType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:inputType="none"
            android:focusable="true"
            android:focusableInTouchMode="false" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Tahun">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Odometer Saat Ini">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOdometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SIMPAN KENDARAAN" />

</LinearLayout>