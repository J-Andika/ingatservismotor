<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo"
                android:contentDescription="Logo Ingat Servis Motor"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvName"
            style="@style/TextAppearance.Honda.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvEmail"
            style="@style/TextAppearance.Honda.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCatalog"
            style="@style/Widget.Honda.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Katalog Komponen" />

        <!-- ── Section: Pengujian Notifikasi ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="@color/gray_200"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        style="@style/TextAppearance.Honda.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengujian Notifikasi"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Honda.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tombol di bawah untuk menguji notifikasi tanpa menunggu jadwal otomatis."
                    android:layout_marginBottom="16dp" />

                <!-- Tombol 1: Notif Perbarui Odometer -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestNotifOdometer"
                    style="@style/Widget.Honda.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🔔  Uji Notif Perbarui Odometer" />

                <!-- Tombol 2: Notif Servis Berkala -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestNotifServis"
                    style="@style/Widget.Honda.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🔔  Uji Notif Waktu Servis" />

                <!-- Tombol 3: Notif Umur Komponen -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestNotifKomponen"
                    style="@style/Widget.Honda.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔔  Uji Notif Umur Komponen" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Honda.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LOGOUT" />

    </LinearLayout>
</ScrollView>